{
  "name": "earthix-pdf-studio",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @earthix/frontend",
    "build": "npm run build --workspace @earthix/frontend",
    "preview": "npm run preview --workspace @earthix/frontend",
    "lint": "npm run lint --workspace @earthix/frontend",
    "prepare:assets": "npm run prepare:assets --workspace @earthix/frontend",
    "postinstall": "npm run prepare:assets",
    "test:engine": "node --test tests/engine/*.test.js",
    "test:document-core": "node --test tests/document-core/*.test.js",
    "test": "node --test tests/engine/*.test.js tests/pdf-viewer/*.test.js tests/document-core/*.test.js tests/font-engine/*.test.js tests/page-manager.*.test.js",
    "test:viewer": "node --test tests/pdf-viewer/*.test.js",
    "test:font-engine": "node --test tests/font-engine/*.test.js",
    "diagnose:pdf": "node frontend/scripts/diagnose-pdf-compatibility.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
